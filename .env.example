# Copy to .env and fill in.
PORT=5173
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/nails_db

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Admin login created/updated by `npm run seed`
ADMIN_USER=admin
ADMIN_PASS=change-me
